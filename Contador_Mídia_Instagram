"""
Conta automaticamente a quantidade de publicações por formato
a partir de uma base exportada das redes sociais.

O script lê um arquivo CSV, identifica os formatos de conteúdo
(Carrossel, Imagem e Reel) e calcula a quantidade de ocorrências
de cada um deles.

Utilizado para análises de distribuição de formatos, acompanhamento
de estratégia de conteúdo e alimentação de relatórios e dashboards.
"""
import pandas as pd

# Carrega a planilha CSV
df = pd.read_csv("dados.csv")

# Coluna I (9ª coluna)
tipos = df.iloc[:, 8].astype(str).str.lower()

# Contagem
carrossel = tipos.str.contains("carrossel do instagram", na=False).sum()
imagem = tipos.str.contains("imagem do instagram", na=False).sum()
reel = tipos.str.contains("reel do instagram", na=False).sum()

print(f"Carrossel do Instagram: {carrossel}")
print(f"Imagem do Instagram: {imagem}")
print(f"Reel do Instagram: {reel}")

