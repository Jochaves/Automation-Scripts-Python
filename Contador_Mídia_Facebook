"""
=========================================================
PROJETO: Contador de Tipos de Conteúdo
AUTOR: João Gabriel Santana Chaves

DESCRIÇÃO:
Este script percorre uma coluna de uma planilha e
contabiliza a quantidade de ocorrências dos formatos
de conteúdo:
- Fotos
- Links
- Live
- Texto
- Vídeos

OBJETIVO:
Automatizar a contabilização de formatos de conteúdo,
reduzindo o trabalho manual em análises e relatórios.

TECNOLOGIA:
Python + Pandas
=========================================================
"""

import pandas as pd


def contar_tipos_conteudo(arquivo_csv, coluna):
    """
    Lê um arquivo CSV e contabiliza a quantidade de
    ocorrências de cada tipo de conteúdo.
    """

    # Carrega a base de dados
    df = pd.read_csv(arquivo_csv)

    # Converte a coluna para texto e minúsculas
    valores = df[coluna].astype(str).str.lower()

    # Inicializa os contadores
    fotos = 0
    links = 0
    live = 0
    texto = 0
    videos = 0

    # Percorre os registros
    for valor in valores:
        if "foto" in valor:
            fotos += 1
        if "link" in valor:
            links += 1
        if "live" in valor:
            live += 1
        if "texto" in valor:
            texto += 1
        if "vídeo" in valor or "video" in valor:
            videos += 1

    # Exibe os resultados
    resultado = {
        "Fotos": fotos,
        "Links": links,
        "Live": live,
        "Texto": texto,
        "Vídeos": videos
    }

    print(resultado)
    return resultado


# Exemplo de uso
contar_tipos_conteudo(
    arquivo_csv="dados.csv",
    coluna="Tipo de Conteúdo"
)
